# Opti-Oignon .gitignore
# Runtime state, user data, and key material must never be committed.

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/

# --- Node / frontend ---
node_modules/
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/

# --- Browser test output (written into the tree by a run) ---
frontend/tests/e2e/playwright-report/
frontend/test-results/

# --- Databases and SQLite sidecars (runtime; may hold personal data) ---
*.db
*.db-wal
*.db-shm
*.db-journal
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
opti_oignon/data/*.db
opti_oignon/data/*.db-wal
opti_oignon/data/*.db-shm
opti_oignon/data/*.db-journal

# Model provenance manifest: local host state, sealed with a local key.
# Committing it would publish the digests of one machine's model files
# and invite a seal made with somebody else's key.
data/model_provenance.json
data/model_provenance.json.tmp
opti_oignon/data/model_provenance.json
opti_oignon/data/model_provenance.json.tmp

# --- Audit chain anchor (per-install integrity tip; not a shared artifact) ---
.audit_chain_anchor
data/.audit_chain_anchor

# --- Plugin execution logs ---
data/plugin_logs/

# --- Red team report output ---
data/redteam_results/

# --- Master key material (keyfile mode, K-01): never commit or back up ---
data/.keyfile

# --- ChromaDB vector persistence (may hold ingested personal documents) ---
opti_oignon/data/project_chroma/

# --- Per-machine accumulated runtime state ---
data/speculative_stats.json
data/plugin_allowlist.json
# Runtime JSON written into the data dirs (tuner_results.json, learned-router
# stats, etc.). The data dirs ship only seed YAMLs, so globbing JSON here keeps
# per-machine state out of the repo without hiding any tracked seed.
data/*.json
opti_oignon/data/*.json
# Pickled / joblib model artifacts (e.g. learned_router.pkl). These are pickle
# under the hood: never commit them, both to keep per-machine state out of the
# repo and to avoid shipping a deserialization sink (see AUDIT LR-01).
*.pkl
*.joblib
# Keyed-MAC sidecars for persisted models (LR-01): per-machine runtime state.
*.mac
fingerprint.db

# --- OS / editor ---
.DS_Store
*.swp

# Keep the repo root limited to standard docs: ignore any other root-level .md
# (internal specs, inventories, session/roadmap/audit notes remain local only)
/*.md
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CODE_OF_CONDUCT.md

# docs/ design and audit artifacts
docs/COLOR_INSPIRATION_*.md
docs/SECURITY_AUDIT_*.md
docs/*_audit_report.json
docs/*palette-preview-*.html

# Runtime data and personal content (never ship in the public repo)
opti_oignon/data/rag/
opti_oignon/data/notes_blobs/
data/.security_mode_lock

# Runtime data and personal content (never ship in the public repo)
opti_oignon/data/rag/
opti_oignon/data/notes_blobs/
data/.security_mode_lock
data/.audit_chain_anchor
data/sandbox_exports/

# Maintainer tooling and personal files: never part of the public tree.
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.gitmodules
.mcp.json
.ripgreprc
.idea
.vscode

# The native core's artefact and build tree: rebuilt from the pinned crate, never tracked
opti_oignon/native/*.so
rust/oo_core/target/
rust/allium/target/
