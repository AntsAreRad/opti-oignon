# Opti-Oignon -- Docker build context exclusions
#
# The backend image (Dockerfile.backend) copies only opti_oignon/, scripts/
# and assets/. Everything below is excluded from the build context to keep the
# image small and to keep host artefacts, runtime state and secrets out of it.

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Tests and documentation are not needed in the runtime image
tests/
docs/

# Frontend sources and node tooling (the backend image is API-only)
frontend/
node_modules/

# Version control and CI metadata
.git/
.github/
.gitignore

# Runtime databases and encrypted stores (never bake into an image)
*.db
*.db-wal
*.db-shm
data/
.audit_chain_anchor
fingerprint.db

# Secrets and key material
*.key
*.pem

# Root-level Markdown: documentation and local notes, none of which the
# image copies
*.md

# Archives and build outputs
*.zip
*.tar
*.tar.gz
build/
dist/
*.egg-info/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
